VMARKET_ENV=development
VMARKET_DEBUG=false
VMARKET_LOG_LEVEL=INFO
# Set privately to the creator's verified account email before owner provisioning.
# VMARKET_OWNER_EMAIL=
VMARKET_DATABASE_URL=postgresql+asyncpg://vmarket:vmarket-local@localhost:5432/vmarket
VMARKET_POSTGRES_DB=vmarket
VMARKET_POSTGRES_USER=vmarket
VMARKET_POSTGRES_PASSWORD=vmarket-local
VMARKET_MINIO_ENDPOINT=localhost:9000
VMARKET_MINIO_ACCESS_KEY=vmarket-local
VMARKET_MINIO_SECRET_KEY=vmarket-local-secret
VMARKET_MINIO_SECURE=false
VMARKET_MINIO_PUBLIC_URL=http://localhost:9000
VMARKET_MINIO_PUBLIC_BUCKET=product-media
VMARKET_MINIO_PRIVATE_BUCKET=vendor-documents
VMARKET_MAIL_HOST=localhost
VMARKET_MAIL_PORT=1025
VMARKET_MAIL_STARTTLS=false
VMARKET_MAIL_FROM=no-reply@vendors-market.local
VMARKET_WEB_BASE_URL=http://localhost:3000
VMARKET_CORS_ORIGINS=["http://localhost:3000"]
# For LAN development, add your exact web origin to VMARKET_CORS_ORIGINS,
# e.g. http://192.168.1.72:3000. Do not use wildcard origins.
# Set these in apps/web/.env.local only when proxy targets differ:
# VMARKET_API_PROXY_URL=http://127.0.0.1:8000
# VMARKET_STORAGE_PROXY_URL=http://localhost:9000
# Leave NEXT_PUBLIC_API_URL unset to use the same-origin /api/v1 proxy.
